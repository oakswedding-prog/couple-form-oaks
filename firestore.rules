rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Any signed-in user (including silent Anonymous couple sessions)
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper: Active link check — unlocked, unrevoked, and within server-enforced 7-day window.
    // Legacy drafts created before linkExpiresAt remain compatible until locked or submitted.
    function isDraftLinkActive(draftData) {
      return draftData.get('revoked', false) != true
        && draftData.get('linkLocked', false) != true
        && (!('linkExpiresAt' in draftData)
          || draftData.linkExpiresAt == null
          || request.time < draftData.linkExpiresAt);
    }

    // Helper: Checks whether the signed-in anonymous user is already a registered participant on a draft
    function isDraftParticipant(draftData) {
      return isSignedIn() && (
        draftData.ownerUid == request.auth.uid
        || (
          ('participantUids' in draftData)
          && (draftData.participantUids is list)
          && request.auth.uid in draftData.participantUids
        )
      );
    }

    // Helper: Checks whether the signed-in couple user is already a participant on a submission record
    function isSubmissionParticipant(data) {
      return isSignedIn() && (
        data.ownerUid == request.auth.uid
        || (
          ('participantUids' in data)
          && (data.participantUids is list)
          && request.auth.uid in data.participantUids
        )
      );
    }

    // Helper: Checks if the signed-in couple is resuming/collaborating on this exact submission
    // via its active unguessable 192-bit resumeToken (verified against drafts/{resumeToken}).
    function isResumedSubmissionOwner(submissionId, data) {
      return isSignedIn()
        && ('resumeToken' in data)
        && (data.resumeToken is string)
        && data.resumeToken.size() >= 22
        && exists(/databases/$(database)/documents/drafts/$(data.resumeToken))
        && isDraftLinkActive(get(/databases/$(database)/documents/drafts/$(data.resumeToken)).data)
        && get(/databases/$(database)/documents/drafts/$(data.resumeToken)).data.submissionId == submissionId
        && isDraftParticipant(get(/databases/$(database)/documents/drafts/$(data.resumeToken)).data);
    }

    // Helper: Checks if the user is an authenticated, NON-ANONYMOUS studio admin
    // authorized via verified team email or an active document in the 'admins' collection.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.auth.token.email != null
        && (
          (
            request.auth.token.email_verified == true
            && request.auth.token.email.lower() in [
              'rahulratna88@gmail.com',
              'mywedding@oakswedding.com',
              'oaksoperations@gmail.com'
            ]
          )
          || (
            exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()))
            && get(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())).data.get('active', true) != false
          )
        );
    }

    // Helper: Checks whether an immutable event submission receipt exists for this eventId
    function isEventArchived(submissionId, eventId) {
      return exists(/databases/$(database)/documents/submissions/$(submissionId)/eventSubmissions/$(eventId));
    }

    // Helper: Checks whether a standard event ('sangeet', 'wedding', 'reception') is marked submitted
    function isStandardEventSubmitted(data, eventKey) {
      return ('productionChecklist' in data)
        && (data.productionChecklist is map)
        && ('events' in data.productionChecklist)
        && (data.productionChecklist.events is map)
        && (eventKey in data.productionChecklist.events)
        && (data.productionChecklist.events[eventKey] is map)
        && (
          data.productionChecklist.events[eventKey].get('submitted', false) == true
          || ('submission' in data.productionChecklist.events[eventKey] && data.productionChecklist.events[eventKey].submission != null)
        );
    }

    // Helper: Ensures once a standard event is submitted/archived, its entire map stays byte-for-byte unchanged
    function standardEventPreserved(oldData, newData, eventKey) {
      return ('productionChecklist' in oldData)
        && (oldData.productionChecklist is map)
        && ('events' in oldData.productionChecklist)
        && (oldData.productionChecklist.events is map)
        && (eventKey in oldData.productionChecklist.events)
        ? (
            ('productionChecklist' in newData)
            && (newData.productionChecklist is map)
            && ('events' in newData.productionChecklist)
            && (newData.productionChecklist.events is map)
            && (eventKey in newData.productionChecklist.events)
            && newData.productionChecklist.events[eventKey] == oldData.productionChecklist.events[eventKey]
          )
        : (
            !('productionChecklist' in newData)
            || !('events' in newData.productionChecklist)
            || !(eventKey in newData.productionChecklist.events)
            || newData.productionChecklist.events[eventKey].get('submitted', false) == true
          );
    }

    // Helper: Protects legacy top-level wedding checklist mirrors once 'wedding' is submitted
    function weddingLegacyMirrorsPreserved(oldData, newData) {
      return (
        !('productionChecklist' in oldData)
        || !(oldData.productionChecklist is map)
        || !('items' in oldData.productionChecklist)
        || (
          ('productionChecklist' in newData)
          && (newData.productionChecklist is map)
          && ('items' in newData.productionChecklist)
          && newData.productionChecklist.items == oldData.productionChecklist.items
        )
      ) && (
        !('productionChecklist' in oldData)
        || !(oldData.productionChecklist is map)
        || !('fileDetails' in oldData.productionChecklist)
        || (
          ('productionChecklist' in newData)
          && (newData.productionChecklist is map)
          && ('fileDetails' in newData.productionChecklist)
          && newData.productionChecklist.fileDetails == oldData.productionChecklist.fileDetails
        )
      );
    }

    // Helper: Validates required permanent submission metadata on lock transition
    function hasValidSubmissionPayload(containerMap, eventId) {
      return ('submission' in containerMap)
        && (containerMap.submission is map)
        && containerMap.submission.eventId == eventId
        && containerMap.submission.eventName is string
        && containerMap.submission.eventName.size() > 0
        && containerMap.submission.eventName.size() <= 100
        && containerMap.submission.submittedBy is string
        && containerMap.submission.submittedBy.size() > 0
        && containerMap.submission.submittedBy.size() <= 120
        && containerMap.submission.submissionDate is string
        && containerMap.submission.submissionDate.size() > 0
        && containerMap.submission.submissionTime is string
        && containerMap.submission.submissionTime.size() > 0
        && containerMap.submission.submittedAt is string
        && containerMap.submission.submittedAt.size() > 0
        && (containerMap.submission.items is map)
        && (containerMap.submission.fileDetails is list);
    }

    // Helper: Validates transition/immutability of a single standard event key
    function standardEventTransitionValid(oldData, newData, submissionId, eventKey) {
      let wasLocked = isStandardEventSubmitted(oldData, eventKey) || isEventArchived(submissionId, eventKey);
      let isNowSubmitted = isStandardEventSubmitted(newData, eventKey);
      return (!wasLocked || standardEventPreserved(oldData, newData, eventKey))
        && (!isNowSubmitted || hasValidSubmissionPayload(newData.productionChecklist.events[eventKey], eventKey));
    }

    // Helper: Validates immutable archive document schema in eventSubmissions subcollection
    function isValidEventSubmissionRecord(data, eventId) {
      return data.keys().hasAll([
          'eventId', 'eventName', 'isCustom', 'submittedBy',
          'submissionDate', 'submissionTime', 'submittedAt', 'items', 'fileDetails'
        ])
        && data.eventId == eventId
        && data.eventName is string && data.eventName.size() > 0 && data.eventName.size() <= 100
        && data.isCustom is bool
        && data.submittedBy is string && data.submittedBy.size() > 0 && data.submittedBy.size() <= 120
        && data.submissionDate is string && data.submissionDate.size() > 0
        && data.submissionTime is string && data.submissionTime.size() > 0
        && data.submittedAt is string && data.submittedAt.size() > 0
        && data.items is map
        && data.fileDetails is list;
    }

    // Helper: Validates custom event document structure in productionEvents subcollection
    function isValidCustomProductionEvent(data, eventId) {
      return data.keys().hasAll(['id', 'name', 'isCustom', 'items', 'fileDetails', 'submitted', 'createdAt', 'updatedAt'])
        && data.id == eventId
        && data.isCustom == true
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.items is map
        && data.fileDetails is list
        && data.submitted is bool
        && data.createdAt is string && data.createdAt.size() > 0
        && data.updatedAt is string && data.updatedAt.size() > 0;
    }

    // Admin Allow-List:
    // Non-anonymous signed-in users can check their own admin doc; only admins can write.
    match /admins/{adminEmail} {
      allow read: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
      allow write: if isAdmin();
    }

    // Sequential Counter:
    // Used by post-save transactions to assign sequential submission numbers (#001, #002...)
    match /counters/{counterId} {
      allow read, write: if isSignedIn();
    }

    // Online Drafts (document ID = 192-bit unguessable resume/invite token):
    // - Listing is strictly admin-only (non-admins can NEVER browse or list drafts).
    // - A signed-in couple can get a single draft ONLY if they possess its unguessable token (>= 22 chars)
    //   AND the link is active (not locked, not revoked, not past 7-day linkExpiresAt).
    // - Supports both collaborative multi-partner participantUids (<= 4 device UIDs) and legacy single-owner flow.
    match /drafts/{draftId} {
      allow list: if isAdmin();
      allow get: if isAdmin()
        || (isSignedIn() && draftId.size() >= 22 && isDraftLinkActive(resource.data));
      allow create: if isSignedIn()
        && draftId.size() >= 22
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.submissionId is string
        && (!('participantUids' in request.resource.data)
          || (request.resource.data.participantUids is list
              && request.resource.data.participantUids.size() <= 4
              && request.auth.uid in request.resource.data.participantUids));
      allow update: if isAdmin()
        || (
          isSignedIn()
          && draftId.size() >= 22
          && isDraftLinkActive(resource.data)
          && request.resource.data.submissionId == resource.data.submissionId
          && (
            // Path A: Collaborative multi-partner update (ownerUid stays fixed, UID joins participantUids <= 4)
            (
              request.resource.data.ownerUid == resource.data.ownerUid
              && ('participantUids' in request.resource.data)
              && (request.resource.data.participantUids is list)
              && request.resource.data.participantUids.size() <= 4
              && request.auth.uid in request.resource.data.participantUids
              && (
                isDraftParticipant(resource.data)
                || resource.data.get('status', 'draft') != 'submitted'
              )
              && (
                !('participantUids' in resource.data)
                || request.resource.data.participantUids.hasAll(resource.data.participantUids)
              )
            )
            // Path B: Legacy single-owner update / resume (100% backward compatible)
            || (
              request.resource.data.ownerUid == request.auth.uid
              && (
                resource.data.ownerUid == request.auth.uid
                || resource.data.get('status', 'draft') != 'submitted'
              )
            )
          )
        );
      allow delete: if isAdmin();
    }

    // Error Diagnostics Log:
    // - Signed-in couples can ONLY create error logs (no personal answers, no resume token).
    // - Only verified studio admins can read; nobody can update or delete.
    match /submissionErrors/{errorId} {
      allow create: if isSignedIn()
        && !('answers' in request.resource.data)
        && !('resumeToken' in request.resource.data);
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Submissions:
    // - Listing is strictly admin-only (blocks listing of any couple data by non-admins).
    // - Couples can create and update ONLY their own record BEFORE it is finalized & unlocked,
    //   and can never write privateNotes or alter admin status.
    // - Private team notes and admin status live in admin-only subcollection adminMeta/main.
    match /submissions/{submissionId} {
      allow list: if isAdmin();
      allow get: if isAdmin()
        || (
          resource.data.get('linkLocked', false) != true
          && (
            isSubmissionParticipant(resource.data)
            || isResumedSubmissionOwner(submissionId, resource.data)
          )
        );
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && !('privateNotes' in request.resource.data);
      allow update: if (
          isAdmin()
          && standardEventTransitionValid(resource.data, request.resource.data, submissionId, 'sangeet')
          && standardEventTransitionValid(resource.data, request.resource.data, submissionId, 'wedding')
          && standardEventTransitionValid(resource.data, request.resource.data, submissionId, 'reception')
          && (
            (!isStandardEventSubmitted(resource.data, 'wedding') && !isEventArchived(submissionId, 'wedding'))
            || weddingLegacyMirrorsPreserved(resource.data, request.resource.data)
          )
        )
        || (
          isSignedIn()
          && resource.data.get('finalized', false) != true
          && resource.data.get('linkLocked', false) != true
          && request.resource.data.get('privateNotes', null) == resource.data.get('privateNotes', null)
          && request.resource.data.get('status', null) == resource.data.get('status', null)
          && (
            (
              isSubmissionParticipant(resource.data)
              && request.resource.data.ownerUid == resource.data.ownerUid
            )
            || (
              isResumedSubmissionOwner(submissionId, resource.data)
              && request.resource.data.resumeToken == resource.data.resumeToken
              && (
                request.resource.data.ownerUid == resource.data.ownerUid
                || request.resource.data.ownerUid == request.auth.uid
              )
            )
          )
        );
      allow delete: if isAdmin();

      // Admin-Only Metadata (privateNotes & status — completely invisible to couples & link holders)
      match /adminMeta/{metaId} {
        allow read, write: if isAdmin();
      }

      // Custom Production Events:
      // - Editable & deletable ONLY before submission
      // - Permanently read-only & non-deletable once submitted == true or archived
      match /productionEvents/{eventId} {
        allow read: if isAdmin();
        allow create: if isAdmin()
          && !isEventArchived(submissionId, eventId)
          && isValidCustomProductionEvent(request.resource.data, eventId)
          && request.resource.data.submitted == false
          && !('submission' in request.resource.data);
        allow update: if isAdmin()
          && resource.data.get('submitted', false) != true
          && !('submission' in resource.data && resource.data.submission != null)
          && !isEventArchived(submissionId, eventId)
          && isValidCustomProductionEvent(request.resource.data, eventId)
          && request.resource.data.id == resource.data.id
          && request.resource.data.createdAt == resource.data.createdAt
          && (
            request.resource.data.submitted != true
            || hasValidSubmissionPayload(request.resource.data, eventId)
          );
        allow delete: if isAdmin()
          && resource.data.get('submitted', false) != true
          && !('submission' in resource.data && resource.data.submission != null)
          && !isEventArchived(submissionId, eventId);
      }

      // Immutable Event Submission Receipts (write-once permanent archive):
      // - Stores Event Name, Submitted By, Submission Date, Submission Time,
      //   Final Checklist Data, and Final File Details for both standard and custom events.
      match /eventSubmissions/{eventId} {
        allow read: if isAdmin();
        allow create: if isAdmin()
          && !exists(/databases/$(database)/documents/submissions/$(submissionId)/eventSubmissions/$(eventId))
          && isValidEventSubmissionRecord(request.resource.data, eventId);
        allow update, delete: if false;
      }
    }
  }
}
