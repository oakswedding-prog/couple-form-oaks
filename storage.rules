rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper: Checks if the user is a NON-ANONYMOUS studio admin via verified email or 'admins' collection
    function isAdmin() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.auth.token.email != null
        && (
          (
            request.auth.token.email_verified == true
            && request.auth.token.email.lower() in [
              'rahulratna88@gmail.com',
              'mywedding@oakswedding.com',
              'oaksoperations@gmail.com'
            ]
          )
          || firestore.exists(/databases/(default)/documents/admins/$(request.auth.token.email.lower()))
        );
    }

    // Couple photo uploads scoped strictly to their own submission + anonymous UID folder:
    // - Only JPEG, PNG, or WebP images up to 15 MB
    // - Only the signed-in couple (matching ownerUid) can upload into their own folder
    // - Only verified studio admins can read, list, update, or delete
    match /submissions/{submissionId}/{ownerUid}/{fileName} {
      allow create: if request.auth != null
                    && request.auth.uid == ownerUid
                    && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp']
                    && request.resource.size <= 15 * 1024 * 1024;
      allow read, update, delete: if isAdmin();
    }

    // Admin read/list/cleanup access for all historical and current folders under submissions/
    // (blocks non-admins from reading or listing any folder or file)
    match /submissions/{allPaths=**} {
      allow read, update, delete: if isAdmin();
    }
  }
}
