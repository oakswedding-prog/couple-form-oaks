{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm run typecheck:libs && pnpm --filter @workspace/oaks-questionnaire run build",
  "outputDirectory": "artifacts/oaks-questionnaire/dist/public",
  "functions": {
    "api/numbering.ts": {
      "includeFiles": "lib/submission-numbering/dist/**"
    },
    "api/moodboard-image.ts": {
      "includeFiles": "lib/submission-numbering/dist/**"
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
